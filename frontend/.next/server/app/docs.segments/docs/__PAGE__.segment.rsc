9:["$","section",null,{"id":"webhooks","className":"scroll-mt-24 border-b border-slate-100 pb-12 pt-2 last:border-0","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-slate-900","children":"Webhooks"}],["$","div",null,{"className":"mt-4 space-y-3 text-[15px] leading-relaxed text-slate-600","children":[["$","p",null,{"children":["When a payment completes, PalkiPay sends a ",["$","code",null,{"className":"rounded-md bg-slate-100 px-1.5 py-0.5 font-mono text-[13px] text-slate-800","children":"POST"}]," with the same JSON body as Verify payment to the payment’s ",["$","code",null,{"className":"rounded-md bg-slate-100 px-1.5 py-0.5 font-mono text-[13px] text-slate-800","children":"webhook_url"}]," (or your default webhook from Settings). The request carries your API key in the ",["$","code",null,{"className":"rounded-md bg-slate-100 px-1.5 py-0.5 font-mono text-[13px] text-slate-800","children":"PALKIPAY-API-KEY"}]," header so you can check it came from PalkiPay. Respond with any 2xx status; failed deliveries are retried after 10 seconds, 1 minute and 5 minutes."]}],["$","div",null,{"className":"my-4 min-w-0 overflow-hidden rounded-xl border border-slate-800 bg-navy-950","children":[["$","div",null,{"className":"border-b border-white/10 px-4 py-2 text-[12px] font-medium text-slate-400","children":"Next.js webhook handler"}],["$","pre",null,{"className":"overflow-x-auto p-4 font-mono text-[12.5px] leading-relaxed text-slate-200","children":"// app/api/palkipay-webhook/route.ts\nexport async function POST(req: Request) {\n  if (req.headers.get(\"palkipay-api-key\") !== process.env.PALKIPAY_API_KEY) {\n    return new Response(\"Unauthorized\", { status: 401 });\n  }\n  const payment = await req.json();\n  if (payment.status === \"COMPLETED\") {\n    await markOrderPaid(payment.metadata.order_id, payment.transaction_id);\n  }\n  return Response.json({ ok: true });\n}"}]]}]]}]]}]
