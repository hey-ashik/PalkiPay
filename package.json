{
  "name": "palkipay",
  "version": "1.0.0",
  "private": true,
  "description": "PalkiPay — automated bKash, Nagad, Rocket & Upay payment gateway for Bangladeshi businesses.",
  "main": "server.js",
  "license": "UNLICENSED",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node server.js --dev",
    "build": "npm run build --workspace frontend",
    "start": "node server.js",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "migrate": "npm run migrate --workspace backend",
    "test": "npm test --workspace backend",
    "push": "node scripts/auto-push.js",
    "autopush": "node scripts/auto-push.js --watch"
  }
}
