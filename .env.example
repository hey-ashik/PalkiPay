# ─────────────────────────────────────────────────────────────
#  PalkiPay environment configuration
#  Copy this file to `.env` (same folder) and fill in real values.
#  On Hostinger, add the same keys under: Node.js app → Environment variables.
#  `.env` is git-ignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# NODE_ENV is set automatically: `npm run dev` = development, `npm start` = production.

# Port the unified server listens on (Hostinger sets PORT automatically)
PORT=3000

# Public URL of the app. Optional: payment links automatically use the domain the
# site is opened on (localhost locally, palkipay.ashiik.com live). It is still used
# for Telegram webhooks, so on the server set it to the real site:
#   Production (Hostinger panel): APP_URL=https://palkipay.ashiik.com
APP_URL=http://localhost:3000

# ── MySQL ────────────────────────────────────────────────────
# On Hostinger use 127.0.0.1 (not "localhost").
# For local development either run MySQL locally (XAMPP / MySQL / MariaDB)
# or enable "Remote MySQL" in hPanel and use the host it shows.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u697802579_palkipaydb
DB_USER=u697802579_palkipayuser
DB_PASSWORD=change-me

# ── Security ─────────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Payments ─────────────────────────────────────────────────
# How long a checkout link stays payable (minutes)
PAYMENT_EXPIRY_MINUTES=60
# How long the checkout waits for the SMS to arrive before sending the
# payment to manual review (seconds)
VERIFY_TIMEOUT_SECONDS=90

# ── Telegram ─────────────────────────────────────────────────
# webhook  = Telegram pushes updates to APP_URL (needs public HTTPS — production)
# polling  = the server polls Telegram (works on localhost — development)
# Leave empty to pick automatically (webhook when APP_URL is https).
TELEGRAM_MODE=
